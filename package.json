{
  "name": "signal-check",
  "version": "0.1.0",
  "private": true,
  "description": "Signal Check: an automated daily news podcast built from RSS feeds",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "produce": "tsx src/cli/produce.ts",
    "register": "tsx src/cli/register.ts",
    "site": "tsx src/cli/build-site.ts",
    "voice-test": "tsx src/cli/voice-test.ts",
    "check-feeds": "tsx src/cli/check-feeds.ts",
    "notify": "tsx src/cli/notify.ts",
    "jingle": "tsx src/cli/make-jingle.ts",
    "cover": "tsx src/cli/make-cover.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
